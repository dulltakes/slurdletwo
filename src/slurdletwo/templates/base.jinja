<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google Consent Mode v2 Initialization -->
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      function getConsentCookie() {
        var match = document.cookie.match(/(^|;\s*)dt_cookie_consent=([^;]+)/);
        return match ? match[2] : null;
      }
      var savedConsent = getConsentCookie();
      var isGranted = savedConsent === 'granted';
      gtag('consent', 'default', {
        'ad_storage': isGranted ? 'granted' : 'denied',
        'ad_user_data': isGranted ? 'granted' : 'denied',
        'ad_personalization': isGranted ? 'granted' : 'denied',
        'analytics_storage': isGranted ? 'granted' : 'denied',
        'wait_for_update': 500
      });
    </script>
    <!-- End Google Consent Mode v2 Initialization -->
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s);j.async=true;j.src=
    'https://go.dulltakes.golf/wisp/telemetry.js?id='+i;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-NVG7578H');</script>
    <!-- End Google Tag Manager -->
    <!-- Microsoft Clarity -->
    <script>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "zawsqbfegp");
    </script>
    <!-- End Microsoft Clarity -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;600;700&display=swap"
          rel="stylesheet">
    <link rel="stylesheet"
          href="{{ url_for('static', filename='css/style.css') }}">
    <link rel="shortcut icon"
          type="image/x-icon"
          href="{{ url_for('static', filename='images/favicon.svg') }}" />
    <title>{% block title %}SLURDLE{% endblock %}</title>
    <meta name="description"
          content="it's like wordle but for slurs. kind of. the name's funny. play it you might learn something.">
    <meta name="theme-color" content="#f4f4f0">
    <link rel="canonical"
          href="https://dulltakes.golf{{ request.path if request else '' }}">
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url"
          content="https://dulltakes.golf{{ request.path if request else '' }}">
    <meta property="og:title" content="SLURDLE">
    <meta property="og:description"
          content="it's like wordle but for slurs. kind of. the name's funny. play it you might learn something.">
    <meta property="og:site_name" content="SLURDLE">
    <meta property="og:image"
          content="{{ url_for('static', filename='images/og-image.png', _external=True) }}">
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@dulltakes">
    <meta name="twitter:creator" content="@dulltakes">
    <meta name="twitter:url"
          content="https://dulltakes.golf{{ request.path if request else '' }}">
    <meta name="twitter:title" content="SLURDLE">
    <meta name="twitter:description"
          content="it's like wordle but for slurs. kind of. the name's funny. play it you might learn something.">
    <meta name="twitter:image"
          content="{{ url_for('static', filename='images/og-image.png', _external=True) }}">
    <!-- JSON-LD Structured Data Schema -->
    <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "VideoGame",
    "name": "SLURDLE",
    "url": "https://dulltakes.golf{{ request.path if request else '' }}",
    "description": "it's like wordle but for slurs. kind of. the name's funny. play it you might learn something.",
    "genre": "Word Game",
    "playMode": "SinglePlayer",
    "applicationCategory": "Game",
    "publisher": {
      "@type": "Person",
      "name": "dulltakes",
      "url": "https://twitter.com/dulltakes"
    }
  }
    </script>
  </head>
  <body class="bg-[#f4f4f0] text-black font-space antialiased min-h-screen flex flex-col justify-center items-center p-3 sm:p-4 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyMCIgaGVpZ2h0PSIyMCI+CjxyZWN0IHdpZHRoPSIyMCIgaGVpZ2h0PSIyMCIgZmlsbD0iI2Y0ZjRmMCIvPgo8Y2lyY2xlIGN4PSIyIiBjeT0iMiIgcj0iMSIgZmlsbD0iI2QxZDFkMSIvPgo8L3N2Zz4=')]">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://go.dulltakes.golf/wisp/ns.html?id=GTM-NVG7578H"
                      height="0"
                      width="0"
                      style="display:none;
                             visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <main class="w-full max-w-lg">
      <div id="question"
           class="w-full p-4 sm:p-8 bg-white rounded-none shadow-brutal border-4 border-black transition-transform duration-200">
        {% block content %}{% endblock %}
      </div>
    </main>
    <!-- Neobrutalist Cookie Consent Banner -->
    <aside id="cookie-banner"
           class="hidden fixed bottom-3 left-3 right-3 sm:left-auto sm:right-4 sm:bottom-4 z-50 bg-white border-4 border-black shadow-brutal p-3 sm:p-4 flex flex-row items-center justify-between gap-3 text-xs sm:text-sm font-bold uppercase"
           role="region"
           aria-label="Cookie consent">
      <span class="tracking-wide">Can I set cookies?</span>
      <div class="flex items-center gap-2 shrink-0">
        <button id="consent-no-btn"
                type="button"
                class="cursor-pointer px-3 py-1.5 bg-red-500 text-white font-bold uppercase border-2 border-black shadow-brutal-sm hover:opacity-90 active:translate-x-0.5 active:translate-y-0.5 transition-all text-xs sm:text-sm">
          No
        </button>
        <button id="consent-yes-btn"
                type="button"
                class="cursor-pointer px-3 py-1.5 bg-brutal-green text-black font-bold uppercase border-2 border-black shadow-brutal-sm hover:opacity-90 active:translate-x-0.5 active:translate-y-0.5 transition-all text-xs sm:text-sm">
          Yes
        </button>
      </div>
    </aside>
    {% block scripts %}{% endblock %}
  </body>
</html>
