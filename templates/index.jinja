{% extends 'base.jinja' %}

{% block title %}SLURDLE{% endblock %}

{% block content %}
  <div class="text-center mb-8">
    <h1
      class="font-archivo text-6xl sm:text-7xl text-white tracking-[2px] uppercase text-shadow-brutal mb-4 -rotate-1 border-black inline-block bg-brutal-pink px-4 py-2 border-4 shadow-brutal-sm">
      SLURDLE
    </h1>

    <div
      class="font-bold bg-white text-black text-[clamp(1rem,2.5vw,1.3rem)] p-4 border-4 border-black shadow-brutal-sm mb-2 uppercase">
      <span class="block mb-2">Which ethnic group does</span>
      <span id="current-slur"
        class="inline-block bg-brutal-yellow px-4 py-1 border-4 border-black font-archivo">
        {{ data.slur }}
      </span>
      <span class="block mt-2">target?</span>
    </div>

    {#    <p class="text-sm font-bold text-gray-500 mt-2">Hint: it's {{ data.correct_target }}</p>#}
  </div>
  <ul id="targets-list" class="space-y-4 m-0 p-0 list-none">
    {% for target in data.targets %}
      <li
        class="target cursor-pointer flex items-center p-4 rounded-none bg-white border-4 border-black text-black font-bold uppercase shadow-brutal transition-all duration-150 hover:bg-brutal-pink hover:text-white hover:shadow-brutal-hover active:shadow-brutal-active text-[1rem] sm:text-[1.2rem]">
        {{ target }}
      </li>
    {% endfor %}
  </ul>
  <dialog id="result-dialog"
          class="p-8 rounded-none shadow-brutal border-4 border-black bg-brutal-green text-black backdrop:bg-black/50 max-w-sm w-[90%] sm:w-full m-auto text-center">

    <h2 class="text-white text-shadow-brutal text-3xl sm:text-4xl font-archivo uppercase mb-4 mt-0 border-black block tracking-widest">Correct!</h2>
    <p id="dialog-text" class="text-sm sm:text-lg font-bold mb-6 uppercase leading-relaxed"></p>

    <button id="next-btn"
            class="hidden w-full bg-brutal-yellow border-4 border-black text-black font-bold py-3 px-6 rounded-none mt-4 uppercase tracking-[2px] shadow-brutal hover:bg-white hover:shadow-brutal-hover active:shadow-brutal-active transition-all duration-150">
      Next Question →
    </button>
  </dialog>

{% endblock %}

{% block scripts %}
  <script type="text/javascript" src="{{ url_for('static', filename='app.js') }}" defer></script>
{% endblock %}
