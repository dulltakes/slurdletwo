{
  "name": "slurdletwo",
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "build": "tailwindcss -i ./src/slurdletwo/static/src/input.css -o ./src/slurdletwo/static/css/style.css --minify && esbuild ./src/slurdletwo/static/src/app.ts --bundle --minify --outfile=./src/slurdletwo/static/app.js",
    "watch": "tailwindcss -i ./src/slurdletwo/static/src/input.css -o ./src/slurdletwo/static/css/style.css --watch & esbuild ./src/slurdletwo/static/src/app.ts --bundle --watch --outfile=./src/slurdletwo/static/app.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^7.0.2"
  }
}
